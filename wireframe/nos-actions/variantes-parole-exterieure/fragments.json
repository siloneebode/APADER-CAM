  "a": "<section class=\"eq-section eq-section-a\" aria-labelledby=\"eq-title\">\n  <div class=\"eq-wrap\">\n    <header class=\"eq-heading\"><p class=\"eq-kicker\">Une parole extérieure</p><h2 class=\"eq-title\" id=\"eq-title\">Un regard sur notre action</h2></header>\n    <figure class=\"eq-card eq-card-long\">\n      <span class=\"eq-corner eq-corner-start\" aria-hidden=\"true\"></span><span class=\"eq-corner eq-corner-end\" aria-hidden=\"true\"></span>\n      <blockquote class=\"eq-quote\"><p>« [Le message développe le regard de cette personne sur l’action de l’APADER dans ce domaine : ce qui retient son attention, l’intérêt de la démarche pour les communautés et les raisons de son soutien.]</p><p>[Un second paragraphe permet de partager son expérience, les échanges qui la rapprochent de cette action, les changements qu’elle souhaite encourager et les perspectives qu’elle envisage. Le texte sera recueilli auprès du partenaire ou du soutien retenu, puis accompagné de son nom, de sa qualité et de sa photo.] »</p></blockquote>\n      <figcaption class=\"eq-attribution\"><div class=\"eq-identity\"><span class=\"eq-avatar\" role=\"img\" aria-label=\"Emplacement pour une photo\">[Photo]</span><div class=\"eq-person\"><p class=\"eq-name\">[Nom et prénom]</p><p class=\"eq-role\">[Fonction ou qualité]</p><p class=\"eq-organization\">[Organisation, si pertinente]</p></div></div></figcaption>\n    </figure>\n  </div>\n</section>",
  "b": "<section class=\"eq-section eq-section-b\" aria-labelledby=\"eq-title\">\n  <div class=\"eq-wrap\">\n    <header class=\"eq-heading\"><p class=\"eq-kicker\">Une parole extérieure</p><h2 class=\"eq-title\" id=\"eq-title\">Un regard sur notre action</h2></header>\n    <figure class=\"eq-statement\">\n      <blockquote class=\"eq-quote\"><p>« [Parole à recueillir sur l’action de l’APADER dans ce domaine, sa portée et les raisons de la soutenir.] »</p></blockquote>\n      <figcaption class=\"eq-attribution\"><div class=\"eq-identity\"><span class=\"eq-avatar\" role=\"img\" aria-label=\"Emplacement pour une photo\">[Photo]</span><div class=\"eq-person\"><p class=\"eq-name\">[Nom et prénom]</p><p class=\"eq-role\">[Fonction ou qualité]</p><p class=\"eq-organization\">[Organisation, si pertinente]</p></div></div></figcaption>\n    </figure>\n  </div>\n</section>"
